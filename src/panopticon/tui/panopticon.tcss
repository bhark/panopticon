/* flat and terminal-native: one background, round borders only, padding 1 on every box */

Screen {
    background: $background;
    color: $foreground;
}

/* focus is a border and a cursor row; textual otherwise tints the whole widget */

*:focus {
    background-tint: $foreground 0%;
}

#goalbar, #detailbar {
    height: 1;
    padding: 0 2;
}

/* panels */

DataTable, #state, #shoutpanel, #activitypanel, #agentstats, #transcript,
#taskmeta, #taskseats, #taskarchive, #truthpanel, #jurypanel {
    background: $background;
    border: round $panel;
    border-title-align: left;
    border-title-color: $primary;
    border-title-style: bold;
    padding: 1;
    scrollbar-size: 1 1;
    scrollbar-background: $background;
    scrollbar-color: $panel;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $primary;
}

DataTable:focus, #shoutpanel:focus, #activitypanel:focus, #transcript:focus,
#truthpanel:focus, #jurypanel:focus {
    border: round $primary;
}

DataTable > .datatable--header, DataTable:focus > .datatable--header {
    background: $background;
    background-tint: $foreground 0%;
    text-style: none;
}

DataTable > .datatable--cursor {
    background: $primary 25%;
}

/* controls */

Button {
    min-width: 0;
    height: 1;
    padding: 0 2;
    border: none;
    background: $background;
    color: $foreground;
    text-style: none;
}

Button:hover {
    background: $panel;
}

Button:focus, Button.-active {
    background: $primary;
    color: $background;
    text-style: bold;
}

Button.-primary {
    color: $primary;
}

Button.-warning {
    color: $warning;
}

Input {
    background: $background;
    color: $foreground;
}

/* overview */

#agents {
    height: 2fr;
}

#lower {
    height: 3fr;
}

#tasks {
    width: 1fr;
}

#right {
    width: 48;
}

#state {
    height: auto;
}

#shoutpanel, #activitypanel {
    height: 1fr;
}

/* agent and task detail */

#agentstats {
    height: auto;
}

#transcript {
    height: 1fr;
}

#taskbody {
    height: 1fr;
}

#taskmeta, #taskseats, #taskarchive {
    height: auto;
    margin-bottom: 1;
}

/* knowledge and jury */

#kbbody {
    height: 1fr;
}

#truthpanel, #jurypanel {
    width: 1fr;
}

/* launch */

LaunchScreen {
    align: center middle;
    background: $background;
}

#launchdialog {
    width: 76;
    height: auto;
    padding: 1;
    background: $background;
    border: round $panel;
    border-title-align: left;
    border-title-color: $primary;
    border-title-style: bold;
}

#launchroster {
    height: auto;
    grid-size: 4;
    grid-columns: 14 10 10 10;
    grid-rows: 1;
    grid-gutter: 0 1;
}

#rosterlabel {
    margin-top: 1;
}

.levellabel, .providerlabel {
    width: 100%;
    padding: 0;
}

.levelcount {
    width: 10;
    height: 1;
    padding: 0;
    border: none;
}

.levelcount:focus {
    background: $panel;
}

#goal, #shoutinput {
    height: 3;
    padding: 0 1;
    border: round $panel;
}

#goal:focus, #shoutinput:focus {
    border: round $primary;
}

#launchtally, #launchhint {
    height: 1;
    margin-top: 1;
}

#launchbuttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

#launchbuttons Button, #confirmbuttons Button {
    margin-left: 2;
}

/* dialogs */

ModalScreen {
    align: center middle;
    background: $background 70%;
}

#shoutdialog, #confirmdialog, #helpdialog {
    width: 76;
    height: auto;
    padding: 1;
    background: $background;
    border: round $panel;
    border-title-align: left;
    border-title-color: $primary;
    border-title-style: bold;
}

#shoutdialog {
    width: 96;
    height: 30;
}

#shouthistory {
    height: 1fr;
    scrollbar-size: 1 1;
}

#shoutinput {
    margin-top: 1;
}

#shouthint, #confirmhint {
    height: 1;
    margin-top: 1;
}

#confirmdialog {
    border: round $warning;
    border-title-color: $warning;
}

#confirmdetail {
    margin-top: 1;
}

#confirmbuttons {
    height: auto;
    align-horizontal: right;
}

/* notifications */

Toast {
    width: 50;
    padding: 1;
    background: $background;
    border: round $panel;
}

Toast.-warning {
    border: round $warning;
}

Toast.-error {
    border: round $error;
}
