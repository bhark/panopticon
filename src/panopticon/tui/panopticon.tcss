/* a dense, quiet monitoring board: one accent, thin borders, no chrome */

Screen {
    background: $background;
    color: $foreground;
}

#goalbar, #detailbar {
    height: 1;
    padding: 0 1;
    background: $panel;
}

/* panels */

DataTable, #state, #shoutpanel, #activitypanel, #agentstats, #transcript,
#taskmeta, #taskseats, #taskarchive, #truthpanel, #jurypanel {
    background: $surface;
    border: round $panel;
    border-title-align: left;
    border-title-color: $primary;
    border-title-style: bold;
    padding: 0 1;
    scrollbar-size: 1 1;
    scrollbar-background: $surface;
    scrollbar-color: $panel;
    scrollbar-color-hover: $primary;
    scrollbar-color-active: $primary;
}

DataTable:focus, #shoutpanel:focus, #activitypanel:focus, #transcript:focus,
#truthpanel:focus, #jurypanel:focus {
    border: round $primary;
}

DataTable > .datatable--header {
    background: $surface;
    text-style: none;
}

DataTable > .datatable--odd-row {
    background: $surface;
}

DataTable > .datatable--even-row {
    background: $background;
}

DataTable > .datatable--cursor {
    background: $primary 25%;
}

/* overview */

#agents {
    height: 2fr;
}

#lower {
    height: 3fr;
}

#tasks {
    width: 1fr;
}

#right {
    width: 48;
}

#state {
    height: auto;
    padding: 1;
}

#shoutpanel, #activitypanel {
    height: 1fr;
}

/* agent and task detail */

#agentstats {
    height: auto;
    padding: 1;
}

#transcript {
    height: 1fr;
}

#taskbody {
    height: 1fr;
}

#taskmeta, #taskseats, #taskarchive {
    height: auto;
    padding: 1;
    margin-bottom: 1;
}

/* knowledge and jury */

#kbbody {
    height: 1fr;
}

#truthpanel, #jurypanel {
    width: 1fr;
    padding: 1;
}

/* launch */

LaunchScreen {
    align: center middle;
    background: $background;
}

#launchdialog {
    width: 76;
    height: auto;
    padding: 1 2;
    background: $surface;
    border: round $primary;
    border-title-align: left;
    border-title-color: $primary;
    border-title-style: bold;
}

#launchroster {
    height: auto;
    margin-top: 1;
    align-vertical: middle;
}

#rosterlabel {
    width: 8;
    padding-top: 1;
}

.levellabel {
    width: auto;
    padding: 1 1 0 2;
}

.levelcount {
    width: 8;
    background: $panel;
    border: tall $panel;
}

.levelcount:focus {
    border: tall $primary;
}

#goal {
    background: $panel;
    border: tall $primary;
}

#launchtally, #launchhint {
    height: 1;
    margin-top: 1;
}

#launchbuttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

#launchbuttons Button {
    margin-left: 2;
    min-width: 16;
}

/* dialogs */

ShoutboxScreen, ConfirmScreen, HelpScreen {
    align: center middle;
    background: $background 70%;
}

#shoutdialog {
    width: 96;
    height: 30;
    background: $surface;
    border: round $primary;
    border-title-align: left;
    border-title-color: $primary;
    border-title-style: bold;
    padding: 1 2;
}

#shouthistory {
    height: 1fr;
    scrollbar-size: 1 1;
}

#shoutinput {
    margin-top: 1;
    background: $panel;
    border: tall $primary;
}

#shouthint {
    height: 1;
}

#confirmdialog, #helpdialog {
    width: 76;
    height: auto;
    background: $surface;
    border: round $warning;
    border-title-align: left;
    border-title-color: $warning;
    border-title-style: bold;
    padding: 1 2;
}

#helpdialog {
    border: round $primary;
    border-title-color: $primary;
}

#confirmdetail {
    margin-top: 1;
}

#confirmbuttons {
    height: auto;
    margin-top: 1;
    align-horizontal: right;
}

#confirmbuttons Button {
    margin-left: 2;
    min-width: 16;
}
